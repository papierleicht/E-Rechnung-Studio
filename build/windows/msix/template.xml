<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="e-rechnung-studio"
        Arguments=""
        InstallLocation="C:\Program Files\papierleicht\E-Rechnung-Studio">
    </Installer>
    <PackageInformation
        PackageName="E-RechnungStudio"
        PackageDisplayName="E-Rechnung-Studio"
        PublisherName="CN=Papierleicht"
        PublisherDisplayName="papierleicht"
        Version="0.1.0.0"
        PackageDescription="Offline invoice application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="de.papierleicht.erechnungstudio"
                Description="Offline invoice application"
                DisplayName="E-Rechnung-Studio"
                ExecutableName="e-rechnung-studio"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>E-Rechnung-Studio</DisplayName>
            <PublisherDisplayName>papierleicht</PublisherDisplayName>
            <Description>Offline invoice application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="e-rechnung-studio.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
